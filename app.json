{
  "expo": {
    "name": "Basecamp Kost",
    "jsEngine": "hermes",
    "slug": "Kelompok-4-Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/basecamp-splash.png",
    "scheme": "kelompok4mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "usesCleartextTraffic": true,
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/basecamp-splash.png",
        "backgroundImage": "./assets/images/basecamp-splash.png",
        "monochromeImage": "./assets/images/basecamp-splash.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Kelompok4Mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
     [
        "expo-splash-screen",
        {
          "image": "./assets/images/basecamp-splash.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/basecamp-splash.png",
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with us for reports.",
          "cameraPermission": "The app accesses your camera to let you take photos for reports."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
